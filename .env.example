APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

GITLAB_URL=
GITLAB_TOKEN=
GITLAB_PROJECT_ID=
GITLAB_BRANCH=main

# Database Seeder Configuration (optional, fallback to demo accounts)
# SEED_AUSBILDER_FIRSTNAME="Alex"
# SEED_AUSBILDER_LASTNAME="Trainer"
# SEED_AUSBILDER_EMAIL="ausbilder@example.com"
# SEED_AUSBILDER_PASSWORD="password"
#
# SEED_AZUBI_FIRSTNAME="Max"
# SEED_AZUBI_LASTNAME="Mustermann"
# SEED_AZUBI_EMAIL="azubi@example.com"
# SEED_AZUBI_PASSWORD="password"
# SEED_AZUBI_BERUF="Fachinformatiker für Anwendungsentwicklung"
# SEED_AZUBI_BETRIEB="Musterfirma GmbH"
# SEED_AZUBI_ABTEILUNG="Softwareentwicklung"
# SEED_AZUBI_BEGINN="2026-09-01 00:00:00"
# SEED_AZUBI_GITLAB_PATH=
#
# SEED_CREATE_SECONDARY_AZUBI=true
# SEED_AZUBI2_FIRSTNAME="Erika"
# SEED_AZUBI2_LASTNAME="Musterfrau"
# SEED_AZUBI2_EMAIL="erika.musterfrau@example.com"
# SEED_AZUBI2_PASSWORD="password"

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
